# Copy to dashboard/.env.local for local dev; set the same values in Vercel.

# --- Google Sheets ---
SHEET_ID=
# The FULL service-account JSON, on one line. In Vercel paste it as-is into the
# env var value; locally, wrap it in single quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- dashboard access ---
# Shared password for the HR team. See dashboard/README.md for the
# per-user Google sign-in upgrade path.
DASHBOARD_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=

# --- AI ---
# The dashboard's only model provider. Powers the Draft action, "Generate a
# template", and the Inbox page's AI reply drafting — all via a direct Groq
# call. Required for any of those; the rest of the dashboard works without it.
GROQ_API_KEY=
# Defaults to llama-3.1-8b-instant if unset.
GROQ_MODEL=

# --- Gmail (optional, independent of everything above) ---
# Set all three to let the Inbox page import a candidate's real Gmail thread
# and send real replies with attachments — see
# dashboard/README.md#gmail--real-import--send and `npm run gmail:oauth`
# (repo root) to obtain GMAIL_REFRESH_TOKEN. Leave blank to keep the Inbox
# fully simulated regardless of SHEET_ID above — this is independently gated.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
