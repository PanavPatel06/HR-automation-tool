# The only env file you need locally. Copy it to dashboard/.env.local.
#
#   - the dashboard reads it (Next.js loads .env.local from this directory)
#   - the repo-root scripts read it too (bootstrap:sheets, seed:demo,
#     check:sheets), so SHEET_ID and the credential live in one place
#   - Render prompts for the same keys when you apply render.yaml; on Vercel
#     they go in Settings -> Environment Variables
#
# Never commit .env.local — it is gitignored, and this file is the template.

# --- Google Sheets ---
# The id in the spreadsheet URL, between /d/ and /edit.
SHEET_ID=
# The FULL service-account JSON, on one line, wrapped in single quotes.
# On Render/Vercel paste it as-is into the value box — no quotes, no escaping.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- setup scripts only (ignored by the dashboard) ---
# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON for local scripts: an absolute
# path to the downloaded key file. Only one of the two is needed.
GOOGLE_APPLICATION_CREDENTIALS=
# true creates the V2 columns as well. Leave unset for V1.
BOOTSTRAP_V2=false

# --- dashboard access ---
# Shared password for the HR team. See dashboard/README.md for the
# per-user Google sign-in upgrade path.
DASHBOARD_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=

# --- AI ---
# The dashboard's only model provider. Powers the Draft action, "Generate a
# template", and the Inbox page's AI reply drafting — all via a direct Groq
# call. Required for any of those; the rest of the dashboard works without it.
GROQ_API_KEY=
# Defaults to llama-3.1-8b-instant if unset.
GROQ_MODEL=

# --- Gmail (optional, independent of everything above) ---
# Set all three to let the Inbox page import a candidate's real Gmail thread
# and send real replies with attachments — see
# dashboard/README.md#gmail--real-import--send and `npm run gmail:oauth`
# (repo root) to obtain GMAIL_REFRESH_TOKEN. Leave blank to keep the Inbox
# fully simulated regardless of SHEET_ID above — this is independently gated.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- branding (optional) ---
# Where email templates fetch the logo from. Unset, it comes from the
# deployment's own origin (RENDER_EXTERNAL_URL / VERCEL_URL), which is right
# in almost every case. Set this only to serve /brand/logo.png from elsewhere.
COMPANY_LOGO_BASE_URL=
