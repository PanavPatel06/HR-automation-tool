# The only env file you need when sending through ZOHO Mail instead of Gmail.
# Copy it to dashboard/.env.local for local work:  cp .env.zoho.example .env.local
#
#   - the dashboard reads it (Next.js loads .env.local from this directory)
#   - the repo-root scripts read it too (bootstrap:sheets, seed:demo,
#     check:sheets), so SHEET_ID and the credential live in one place
#   - Render prompts for the same keys when you apply render.yaml
#
# NO CODE CHANGES are needed for Zoho. The mailer already speaks plain SMTP;
# Zoho is only a different MAIL_HOST / MAIL_PORT / MAIL_USER / MAIL_PASSWORD.
#
# Never commit .env.local — it is gitignored, and this file is the template.
# Leave SHEET_ID and MAIL_PASSWORD blank locally: the dashboard then runs on a
# built-in sample dataset and sends nothing.

# --- Google Sheets (the database) ---   [identical to the Gmail setup]
# The id in the spreadsheet URL, between /d/ and /edit.
SHEET_ID=
# The FULL service-account JSON, on one line, wrapped in single quotes.
# On Render paste it as-is into the value box — no quotes, no escaping.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON, for the local setup scripts only
# (the dashboard ignores it): an absolute path to the downloaded key file.
GOOGLE_APPLICATION_CREDENTIALS=

# --- dashboard access ---
# Shared password for the HR team.
DASHBOARD_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=

# --- AI ---
# The only model provider. Powers "Write with AI", the Draft action, and
# "Generate a template". Required for those; the rest works without it.
GROQ_API_KEY=
# Defaults to llama-3.1-8b-instant if unset.
GROQ_MODEL=

# --- sending email (Zoho Mail over SMTP) ---
# MAIL_USER and MAIL_PASSWORD are both required to send for real. Without them
# the app refuses to send while dry run is off, rather than pretending it sent.
#
# Zoho setup (about 5 minutes):
#   1. Sign in to the sending mailbox at mail.zoho.com (or mail.zoho.in).
#   2. Turn on two-factor auth:
#        Settings (gear icon) -> Security -> Multi-Factor Authentication -> enable.
#      Without 2FA, Zoho will not let you create an app password.
#   3. Create an app password:
#        My Account (accounts.zoho.com) -> Security -> App Passwords ->
#        "Generate New Password" -> name it "hr-dashboard" -> Generate.
#      Copy the string it shows. Paste it into MAIL_PASSWORD WITHOUT spaces.
#      It is shown once.
#   4. Confirm SMTP is allowed for your plan and find your exact host:
#        Zoho Mail -> Settings -> Mail Accounts -> click your address ->
#        the "IMAP/SMTP" / "Outgoing Server (SMTP)" section shows the host.
#      Common hosts (must match the region your Zoho account is hosted in):
#        smtp.zoho.com     - US / global accounts
#        smtp.zoho.in      - India accounts
#        smtp.zoho.eu      - Europe accounts
#        smtp.zoho.com.au  - Australia accounts
#        smtppro.zoho.com  - paid organisation (Zoho Workplace / Mail paid) accounts
#      Using the wrong region's host fails with E-MAIL-AUTH or E-MAIL-NETWORK.
#
# Because your company owns the domain, Zoho keeps MAIL_FROM as you set it
# (Gmail would rewrite it). No domain verification step here — buying the
# mailbox from Zoho already did it.

# The full Zoho address that logs in and sends.
MAIL_USER=hiring@yourcompany.com
# The APP PASSWORD from step 3 — never the normal Zoho account password.
MAIL_PASSWORD=

# Optional display name. Defaults to MAIL_USER.
MAIL_FROM=3Space Hiring <hiring@yourcompany.com>

# REQUIRED for Zoho (unlike Gmail, these are not the defaults).
# Set MAIL_HOST to the host you confirmed in step 4.
# Port 465 = implicit TLS (recommended). Port 587 = STARTTLS.
MAIL_HOST=smtp.zoho.in
MAIL_PORT=465

# Candidates' replies go to the `company_email` value in the Config tab. Set
# that in Settings, not here. For Zoho it is usually the same as MAIL_USER, so
# replies land back in the mailbox HR already watches.

# --- branding (optional) ---
# Where email templates fetch the logo from. Unset, it comes from the
# deployment's own origin (RENDER_EXTERNAL_URL), which is right in almost
# every case. Set this only to serve /brand/logo.png from elsewhere.
COMPANY_LOGO_BASE_URL=
