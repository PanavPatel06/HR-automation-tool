# Root .env — used by the scripts in scripts/ (bootstrap-sheets, seed:demo).
# The dashboard has its own env file: dashboard/.env.example

# The id from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Absolute path to the downloaded service-account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Set to true to create the V2 columns as well. Leave unset for V1.
BOOTSTRAP_V2=false
