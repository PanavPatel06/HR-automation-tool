# Copy to n8n/.env and fill in. This file is read by docker compose.
# Never commit the filled-in version.

# --- host ---
N8N_HOST=n8n.example.com
LETSENCRYPT_EMAIL=you@example.com
TZ=Asia/Kolkata

# --- n8n editor login ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Generate once and keep a backup — changing it orphans every saved credential:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- database ---
POSTGRES_USER=n8n
POSTGRES_DB=n8n
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# --- application ---
# The spreadsheet id from its URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# console.groq.com/keys
GROQ_API_KEY=
# aistudio.google.com/apikey — strongly recommended: without it there is no
# failover, so a Groq outage stops drafting entirely.
GEMINI_API_KEY=

# Shared secret for dashboard -> n8n webhook signing. Must match the value in
# the dashboard's environment exactly.
#   openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Where fatal-severity alerts are sent. Leave blank to disable alert emails.
ALERT_EMAIL=

N8N_LOG_LEVEL=info
